# Copy to the ignored repository-root `.env.local` for Cloudflare CLI tasks.
# Never place these values in `apps/dashboard/.env*`; Vite variables are public.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Guarded D1 commands require this exact, separately verified database name.
# `cloudflare:sync-d1` still refuses any database that is not empty or exact-v2.
INBOXPLEASE_D1_NAME=inboxplease
