{
  "name": "@inboxplease/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "node scripts/validate-production-config.mjs .env.production && npm run build && wrangler pages deploy dist --project-name inboxplease-dashboard"
  },
  "dependencies": {
    "@inboxplease/api": "0.1.0",
    "hono": "^4.12.31",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.112.0"
  }
}
